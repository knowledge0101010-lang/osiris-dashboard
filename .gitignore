__pycache__/
*.py[cod]

# Dev scripts (one-time migration helpers).
# Uses scripts/* rather than scripts/ so named tools below can be re-included:
# git does not descend into a directory excluded by its directory form, and a
# pattern containing a slash stays rooted at this file — so nested paths such as
# .claude/skills/*/scripts/ are not caught by it.
scripts/*
!scripts/collect-device-info.sh

# AI agent config files
# CLAUDE.md is tracked: it carries shared project rules (SSRF guard, rate
# limiting, orchestra/android invariants) that every contributor's agent needs.
# AGENTS.md stays ignored for personal, per-developer preferences.
AGENTS.md

# Internal dev notes
DO_NOT_PUSH.md
implementation_plan.md

# Security - prevent accidental backup commits
scanner_backend_backup.js

# Security - Prevent accidental manual leaks
*Manual*.md

# Orchestra runtime output (worker branches are committed; run artifacts are not)
/.orchestra/

# Android bridge local state (pairing hosts, device serials)
/android/.local/
