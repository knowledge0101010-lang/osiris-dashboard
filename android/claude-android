#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════════════
#  claude-android — Claude Code launcher for Android/Termux
#
#  Wraps `claude` with the things a phone needs and a laptop
#  does not: a tmux session that survives the app being swiped
#  away, a wake lock so the OS does not kill a long run, and a
#  narrow-screen friendly default.
#
#      claude-android              start or attach to a session
#      claude-android attach       attach to the running session
#      claude-android new          force a fresh session
#      claude-android stop         end the session, release the lock
#      claude-android status       what is running right now
#      claude-android doctor       diagnose a broken setup
#      claude-android -- <args>    pass args straight through to claude
# ═══════════════════════════════════════════════════════════════

set -euo pipefail

SESSION="claude"
WAKELOCK_MARKER="$HOME/.claude-android-wakelock"

say()  { printf '\033[1;36m▸\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

session_exists() { tmux has-session -t "$SESSION" 2>/dev/null; }

# ── wake lock ────────────────────────────────────────────────────
acquire_lock() {
  have termux-wake-lock || { warn "termux-api not installed; skipping wake lock"; return; }
  termux-wake-lock 2>/dev/null && : > "$WAKELOCK_MARKER" || warn "could not acquire wake lock"
}

release_lock() {
  have termux-wake-unlock || return 0
  termux-wake-unlock 2>/dev/null || true
  rm -f "$WAKELOCK_MARKER"
}

# ── narrow terminal warning ──────────────────────────────────────
# Claude Code's diff and table rendering degrades badly below ~60
# columns. Better to say so once than to have the user think the
# tool is broken.
check_width() {
  local cols
  cols="$(tput cols 2>/dev/null || echo 80)"
  if [ "$cols" -lt 60 ]; then
    warn "terminal is ${cols} columns — diffs and tables will wrap badly"
    printf '    Try: rotate to landscape, or shrink the font (Termux: Vol-Up + minus)\n'
  fi
}

# ── preflight ────────────────────────────────────────────────────
preflight() {
  [ -d "/data/data/com.termux" ] || die "not running inside Termux — see android/README.md"
  have claude || die "'claude' not found. Run: bash android/termux-setup.sh"
  have tmux   || die "'tmux' not found. Run: pkg install tmux"
}

# ── commands ─────────────────────────────────────────────────────
cmd_start() {
  preflight
  check_width

  if session_exists; then
    say "Attaching to the existing '$SESSION' session"
    exec tmux attach -t "$SESSION"
  fi

  acquire_lock
  say "Starting Claude Code in tmux session '$SESSION'"
  printf '    Detach with Ctrl-B then D — the session keeps running.\n\n'

  # -A attaches if the session appeared between the check and now.
  # Pass the command as separate arguments, not one string: tmux execs an argv
  # directly but hands a single string to a shell, which would re-split on
  # whitespace, expand globs, and run metacharacters in `claude --foo "two words"`.
  exec tmux new-session -A -s "$SESSION" claude "$@"
}

cmd_attach() {
  preflight
  session_exists || die "no session named '$SESSION'. Start one with: claude-android"
  exec tmux attach -t "$SESSION"
}

cmd_new() {
  preflight
  if session_exists; then
    say "Killing the existing '$SESSION' session"
    tmux kill-session -t "$SESSION"
  fi
  cmd_start "$@"
}

cmd_stop() {
  if session_exists; then
    tmux kill-session -t "$SESSION"
    ok "session '$SESSION' ended"
  else
    warn "no session named '$SESSION'"
  fi
  release_lock
  ok "wake lock released"
}

cmd_status() {
  printf '\n\033[1m  claude-android status\033[0m\n\n'
  if session_exists; then
    ok "session '$SESSION' is running"
    tmux list-windows -t "$SESSION" 2>/dev/null | sed 's/^/    /'
  else
    warn "no session running"
  fi
  [ -f "$WAKELOCK_MARKER" ] && ok "wake lock held" || warn "no wake lock"
  have claude && ok "claude $(claude --version 2>/dev/null || echo '(version unknown)')" || warn "claude not installed"
  pgrep -x sshd >/dev/null 2>&1 && ok "sshd listening on 8022" || warn "sshd not running"
  printf '\n'
}

cmd_doctor() {
  printf '\n\033[1m  claude-android doctor\033[0m\n\n'
  local problems=0

  check() {
    # check <label> <command...>
    local label="$1"; shift
    if "$@" >/dev/null 2>&1; then
      ok "$label"
    else
      warn "$label"
      problems=$((problems + 1))
    fi
  }

  check "Termux environment"        test -d /data/data/com.termux
  check "node installed"            command -v node
  check "npm installed"             command -v npm
  check "git installed"             command -v git
  check "tmux installed"            command -v tmux
  check "claude installed"          command -v claude
  check "termux-api installed"      command -v termux-wake-lock
  check "shared storage linked"     test -d "$HOME/storage"
  check "network reachable"         ping -c1 -W2 1.1.1.1

  printf '\n'
  if [ "$problems" -eq 0 ]; then
    ok "no problems found"
  else
    warn "$problems problem(s). Re-run: bash android/termux-setup.sh"
  fi
  printf '\n'
  return 0
}

usage() {
  sed -n '3,16p' "$0" | sed 's/^# \{0,2\}//;s/^#//'
}

# ── dispatch ─────────────────────────────────────────────────────
main() {
  case "${1:-start}" in
    start)          shift || true; cmd_start "$@" ;;
    attach)         cmd_attach ;;
    new)            shift; cmd_new "$@" ;;
    stop)           cmd_stop ;;
    status)         cmd_status ;;
    doctor)         cmd_doctor ;;
    --)             shift; cmd_start "$@" ;;
    -h|--help|help) usage ;;
    *)              cmd_start "$@" ;;
  esac
}

main "$@"
